# Hostinger (Apache) config for the static export in /out.

ErrorDocument 404 /404.html

# Pages export as /tickets.html etc.; serve them at /tickets and /tickets/ (query string kept).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Apple Pay checks this file directly. Do not rewrite it to an HTML page.
  RewriteRule ^\.well-known/ - [L]
  RewriteCond %{REQUEST_URI} ^/(.+?)/?$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# Generated share images and app icon are exported without an extension.
<FilesMatch "^(opengraph-image|twitter-image|apple-icon)$">
  ForceType image/png
</FilesMatch>
<Files "apple-developer-merchantid-domain-association">
  ForceType application/octet-stream
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change; everything else revalidates.
  SetEnvIf Request_URI "^/_next/static/" IMMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(self)"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://*.js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.stripe.com; connect-src 'self' https://api.stripe.com https://r.stripe.com https://*.stripe.com https://curprrfrkefegefqiign.supabase.co; frame-src https://js.stripe.com https://hooks.stripe.com https://*.js.stripe.com https://*.stripe.com; worker-src 'self' blob:; form-action 'self' https://theonemorecompany.com"
</IfModule>
